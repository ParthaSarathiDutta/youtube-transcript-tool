TRANSCRIPT_API_KEY=your_api_key_here

# YouTube Data API v3 (Phase 1 discovery — https://console.cloud.google.com/apis/library/youtube.googleapis.com)
YOUTUBE_API_KEY=your_youtube_data_api_key
YOUTUBE_CHANNEL_HANDLE=aiDotEngineer

# Optional discovery tuning
DISCOVERY_LOOKBACK_HOURS=24
DISCOVERY_RECOVERY_LOOKBACK_DAYS=7

# OpenAI summarization
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# Local archive root (private content — not committed to public app repo)
ARCHIVE_ROOT=archive
ARCHIVE_GITHUB_REPO=your-user/youtube-ai-learning-archive
ARCHIVE_GITHUB_TOKEN=

# SMTP email (e.g. Gmail app password)
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
SEND_EMAIL_ON_ZERO_VIDEOS=false
